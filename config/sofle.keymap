/*
 * Copyright (c) 2020 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * Sofle — full keyboard keymap (covers BOTH halves + dongle central)
 * neuroman.tech: https://github.com/neuromantech/zmk-config
 *
 * ============================================================================
 * EXPERIMENT: one-handed right-half layout, swapped by the encoder.
 * Branch: one-handed  (main is untouched — flash a main build to revert)
 * ============================================================================
 *
 * Idea: with only the right half built, make it type the WHOLE keyboard by
 * carrying two layouts and flipping between them with the rotary encoder:
 *
 *   encoder CLOCKWISE      -> layer 0 (RIGHT side)  right-half characters
 *   encoder ANTICLOCKWISE  -> layer 4 (LEFT side)   left-half characters
 *
 * Layer 4 is a STRAIGHT COPY of the left half in reading order — right-half
 * column N emits left-half column N, so the columns line up visually as you
 * read across:
 *
 *   right half col:   0    1    2    3    4    5
 *   row1 (was):       Y    U    I    O    P   BSPC
 *   row1 emits:      ESC   Q    W    E    R    T
 *   row2 (was):       H    J    K    L    ;    '
 *   row2 emits:      TAB   A    S    D    F    G
 *   row3 (was):       N    M    ,    .    /   RSFT
 *   row3 emits:     LSFT   Z    X    C    V    B
 *
 *   NOTE: this is NOT the finger-consistent mapping (that would be a mirror).
 *   Here the right index finger hits the left hand's outer-column keys.
 *
 * ROW 0 WRINKLE: the left half's top row has 6 keys (` 1 2 3 4 5) but the right
 * half's RC(0,11) position is unpopulated (the in-tree keymap puts &none there;
 * it is the encoder's neighbourhood, not a switch). So the digits are shifted
 * onto the five real positions (1 2 3 4 5) and the ` is parked on the dead
 * position. The ` stays reachable on the lower layer.
 *
 * Thumb cluster is IDENTICAL to layer 0 so space and the modifiers stay under
 * the hand. Left-half thumb positions are &none (not physically present).
 *
 * HOW IT WORKS (v0.3 has no stock "encoder changes layer" behavior):
 *   `zmk,behavior-sensor-rotate-var` takes two ARBITRARY behaviors as its
 *   bindings — one per rotation direction — and `override_params` feeds the
 *   keymap's two cells in as the parameter. So we bind `<&to>, <&to>` and pass
 *   layer numbers: `&side_swap 0 4` means CW -> &to 0, CCW -> &to 4.
 *   (&to fires on press only, which suits a tapped sensor event.)
 *
 *   The right half's encoder is sensor index 1 (sensors are indexed positionally
 *   over the zmk,keymap-sensors list, and the peripheral forwards that index
 *   verbatim), so it drives sensor-bindings entry [1].
 *
 * NOTE: sensor-bindings are per-layer, so the swap is bound on BOTH layer 0 and
 * layer 4 — otherwise the encoder dies on the other layer and there is no way
 * back. Layers 1/2/3 (momentary) keep the old scroll/track-skip encoder.
 *
 * STILL REACHABLE: layers 1 (lower) and 2 (raise) keep &sys_reset / &bootloader
 * on the two spacebar-half positions — important, since the dongle's RST trace
 * is severed and this is the only route into its bootloader.
 *
 * Hardware: 3x SuperMini NRF52840 (ZMK board id: nice_nano_v2)
 *   - sofle_left  / sofle_right : halves (encoders fitted)
 *   - sofle_dongle              : BLE dongle (central, no keys)
 *
 * RGB underglow NOT enabled (LEDs not soldered yet) — no &rgb_ug here.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE    0
#define LOWER   1
#define RAISE   2
#define ADJUST  3
/* NOTE: must NOT be called LEFT — keys.h already defines LEFT as the arrow
 * keycode, and redefining it silently rewrites `&kp LEFT`. */
#define LEFTSIDE 4

/ {

    /* ADJUST activates while LOWER + RAISE are both held */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        /*
         * Encoder -> layer switch. Two cells from the keymap:
         *   cell 1 = layer for CLOCKWISE,  cell 2 = layer for ANTICLOCKWISE.
         */
        side_swap: side_swap {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&to>, <&to>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "right";
/*
 * Layer 0 — RIGHT side characters (the normal right-half layout).
 * ,-----------------------------------------------------------.
 * |   `  |  1 |  2 |  3 |  4 |  5 |          |  6 |  7 |  8 |  9 |  0 |      |
 * |  ESC |  Q |  W |  E |  R |  T |          |  Y |  U |  I |  O |  P | BKSP |
 * |  TAB |  A |  S |  D |  F |  G |          |  H |  J |  K |  L |  ; |  '   |
 * | LSFT |  Z |  X |  C |  V |  B |  MUTE    |  N |  M |  , |  . |  / | RSFT |
 * |      | GUI | ALT | CTL |LOWER| RET | SPACE |RAISE| RCTL| RALT| RGUI|    |
 */
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &none
&kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &none      &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                 &kp LGUI &kp LALT &kp LCTRL &mo LOWER  &kp RET    &kp SPACE  &mo RAISE  &kp RCTRL &kp RALT  &kp RGUI
            >;

            /* Encoder swaps the two one-handed layouts: CW -> 0 (right), CCW -> 4 (left) */
            sensor-bindings = <&side_swap BASE LEFTSIDE &side_swap BASE LEFTSIDE>;
        };

        lower_layer {
            display-name = "lower";
/*
 * Layer 1 — numbers / symbols / F-keys (momentary, LOWER thumb)
 */
            bindings = <
&trans    &kp F1    &kp F2    &kp F3      &kp F4    &kp F5                    &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &kp F11
&kp GRAVE &kp N1    &kp N2    &kp N3      &kp N4    &kp N5                    &kp N6    &kp N7   &kp N8    &kp N9    &kp N0    &kp F12
&trans    &kp EXCL  &kp AT    &kp HASH    &kp DLLR  &kp PRCNT                 &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
&trans    &kp EQUAL &kp MINUS &kp PLUS    &kp LBRC  &kp RBRC   &sys_reset &bootloader  &kp LBKT  &kp RBKT &kp SEMI  &kp COLON &kp BSLH  &trans
                    &trans    &trans      &trans    &trans     &trans &trans  &trans    &trans   &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        raise_layer {
            display-name = "raise";
/*
 * Layer 2 — nav / Bluetooth / clipboard (momentary, RAISE thumb).
 * Bootloader escape lives here (see NOTE at the top of the file).
 */
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans    &trans   &trans    &trans  &trans
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &trans    &kp UP   &trans    &kp N0  &trans
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &kp DEL &kp BSPC
&trans      &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans        &sys_reset &bootloader  &trans    &trans    &trans   &trans    &trans  &trans
                        &trans       &trans       &trans       &trans        &trans  &trans  &trans    &trans    &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        adjust_layer {
            display-name = "adjust";
/*
 * Layer 3 — system / power (conditional: LOWER + RAISE held together).
 * RGB intentionally omitted (LEDs not soldered).
 */
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &none &none
&ext_power EP_TOG &none           &none           &none           &none           &none                                   &none &none &none &none &none &none
&none             &none           &none           &none           &none           &none                                   &none &none &none &none &none &none
&none             &none           &none           &none           &none           &none            &none &none          &none &none &none &none &none &none
                                  &none           &none           &none           &none            &none           &none  &none &none &none &none
            >;
        };

        left_layer {
            display-name = "left one-hand";
/*
 * Layer 4 — LEFT half characters, letters starting at the FAR-LEFT column.
 * Reached by turning the encoder ANTICLOCKWISE; clockwise goes back.
 *
 *   right half col:   0    1    2    3    4    5 (pinky / outer edge)
 *   row 0 emits:      1    2    3    4    5    `
 *   row 1 emits:      Q    W    E    R    T   ESC
 *   row 2 emits:      A    S    D    F    G   TAB
 *   row 3 emits:      Z    X    C    V    B  LSHFT
 *
 * The letters fill the inner five columns in reading order and the outer
 * column carries the left half's specials, so the TAB/SHIFT/ESC/` keys land
 * under the pinky where a modifier belongs. The ` sits on the unpopulated
 * sixth position (RC(0,11)), so it is reachable via the lower layer instead.
 */
            bindings = <
&none     &none     &none     &none     &none     &none                         &kp N1 &kp N2    &kp N3    &kp N4    &kp N5    &kp GRAVE
&none     &none     &none     &none     &none     &none                         &kp Q  &kp W     &kp E     &kp R     &kp T     &kp ESC
&none     &none     &none     &none     &none     &none                         &kp A  &kp S     &kp D     &kp F     &kp G     &kp TAB
&none     &none     &none     &none     &none     &none      &none     &none    &kp Z  &kp X     &kp C     &kp V     &kp B     &kp LSHFT
                              &none     &none     &none     &none     &none             &kp SPACE &mo RAISE &kp RCTRL &kp RALT &kp RGUI
            >;

            /* Must repeat the swap here, or the encoder is dead on this layer */
            sensor-bindings = <&side_swap BASE LEFTSIDE &side_swap BASE LEFTSIDE>;
        };

        /* --- ZMK Studio headroom ------------------------------------------
         * Ignored by normal ZMK builds, but offered to ZMK Studio, which
         * cannot ADD layers beyond what the devicetree declares. Declaring
         * reserved layers here is the documented way to get room to build
         * extra layers at runtime (Studio can rename/enable these).
         * ------------------------------------------------------------------ */
        studio_extra_1 { status = "reserved"; };
        studio_extra_2 { status = "reserved"; };
        studio_extra_3 { status = "reserved"; };
    };
};
