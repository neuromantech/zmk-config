# Sofle dongle shield defaults
# https://zmk.dev/docs/development/hardware-integration/dongle

if SHIELD_SOFLE_DONGLE

# Max 16 characters
config ZMK_KEYBOARD_NAME
    default "Sofle"

# The dongle is the split central (the keyboard connects to the host through it)
config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Two peripherals: left + right halves
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# BT_MAX_CONN = peripherals + desired BT profiles (5 default) => 7
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
